server {
    listen 80;
    server_name _;
    # Redirect to the groundctl UI/API on 443, NOT the published-repo port
    # below. Real bug found live: this used to redirect to
    # https://$host:__NGINX_PORT__ (the repo port, e.g. 8080) — the only
    # thing on this host listening on port 80 at all, so it intercepted
    # every plain-HTTP request, including a browser's default scheme guess
    # when a human types the bare hostname expecting the web UI. apt
    # clients never hit this redirect (sources.list uses explicit
    # https://host:port URLs, port 80 is unused in that flow), so its only
    # real audience is humans — and the UI on 443 is what they want. See
    # docs/https.md for the self-signed-by-default posture and how to swap
    # in a CA-issued cert for production.
    return 301 https://$host$request_uri;
}

server {
    listen __NGINX_PORT__ ssl;
    server_name _;

    ssl_certificate __TLS_CERT_PATH__;
    ssl_certificate_key __TLS_KEY_PATH__;

    # aptly publishes to <rootDir>/public/<prefix>/... which is exactly
    # the layout apt expects at http://host/<prefix>/dists/... and
    # http://host/<prefix>/pool/...
    root /var/lib/groundctl/aptly/public;

    location / {
        autoindex on;
    }
}
