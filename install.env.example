# Install-time variables for ./install.sh (native systemd install).
#
# These are read as environment variables, or pass the equivalent flags
# directly: --fleet-hostname, --nginx-port. If neither is set, install.sh
# prompts for them interactively instead. See docs/install.md.

# The address your managed hosts will use to reach this server's published
# repos — must be resolvable/reachable FROM every host you plan to manage,
# not just from this machine.
GROUNDCTL_FLEET_HOSTNAME=change_this_to_your_real_hostname

# Port nginx serves published repos on.
GROUNDCTL_NGINX_PORT=8080

# First admin user, created once at install time (skipped silently on
# re-run if an admin already exists). If GROUNDCTL_ADMIN_PASSWORD is left
# unset and install.sh isn't running on a real terminal, a random
# password is generated and printed once in the install summary instead.
GROUNDCTL_ADMIN_USERNAME=admin
GROUNDCTL_ADMIN_EMAIL=change_this_to_your_real_email
GROUNDCTL_ADMIN_PASSWORD=
