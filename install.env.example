# Install-time variables for ./install.sh (native systemd install).
#
# These are read as environment variables, or pass the equivalent flags
# directly: --fleet-hostname, --nginx-port. See docs/install.md.

# The address your managed hosts will use to reach this server's published
# repos — must be resolvable/reachable FROM every host you plan to manage,
# not just from this machine.
GROUNDCTL_FLEET_HOSTNAME=change_this_to_your_real_hostname

# Port nginx serves published repos on.
GROUNDCTL_NGINX_PORT=8080
